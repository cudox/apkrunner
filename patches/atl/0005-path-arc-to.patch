-/* translated to gsk_path_builder_svg_arc_to, maybe there are more performant ways to implement this? */
+/*
+ * Convert an Android/Skia style elliptical arc (center, radii, start angle and
+ * sweep angle) into cubic Bezier segments. We deliberately don't use
+ * gsk_path_builder_svg_arc_to() here: it has to infer the center from the
+ * endpoints, cannot represent a full circle (identical endpoints), and some
+ * GSK versions spin forever on degenerate input. Since arcTo() already gives
+ * us the center parameterization, emitting the Bezier segments directly is
+ * both simpler and safer.
+ */
+static void path_arc_to_bezier(GskPathBuilder *builder, double cx, double cy, double rx, double ry,
+                               double start_angle, double sweep_angle, gboolean force_move_to)
+{
+	const graphene_point_t start = GRAPHENE_POINT_INIT(cx + rx * cos(start_angle),
+	                                                   cy + ry * sin(start_angle));
+
+	if (force_move_to) {
+		gsk_path_builder_move_to(builder, start.x, start.y);
+	} else {
+		const graphene_point_t *current = gsk_path_builder_get_current_point(builder);
+		if (current == NULL || !graphene_point_equal(current, &start))
+			gsk_path_builder_line_to(builder, start.x, start.y);
+	}
+
+	if (sweep_angle == 0.0)
+		return;
+
+	/* An arc of more than a full turn doesn't add useful geometry. */
+	if (fabs(sweep_angle) > 2.0 * G_PI)
+		sweep_angle = sweep_angle > 0.0 ? 2.0 * G_PI : -2.0 * G_PI;
+
+	const int segments = MAX(1, (int)ceil(fabs(sweep_angle) / (G_PI_2)));
+	const double delta = sweep_angle / segments;
+	const double k = (4.0 / 3.0) * tan(delta / 4.0);
+
+	double t = start_angle;
+	graphene_point_t p0 = start;
+	for (int i = 0; i < segments; i++) {
+		const double t1 = t + delta;
+		const graphene_point_t p3 = GRAPHENE_POINT_INIT(cx + rx * cos(t1), cy + ry * sin(t1));
+		const graphene_point_t c1 = GRAPHENE_POINT_INIT(p0.x - k * rx * sin(t), p0.y + k * ry * cos(t));
+		const graphene_point_t c2 = GRAPHENE_POINT_INIT(p3.x + k * rx * sin(t1), p3.y - k * ry * cos(t1));
+		gsk_path_builder_cubic_to(builder, c1.x, c1.y, c2.x, c2.y, p3.x, p3.y);
+		t = t1;
+		p0 = p3;
+	}
+}
