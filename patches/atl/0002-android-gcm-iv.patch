 	private final static String TAG = "AndroidKeyStore";
 
+	static {
+		try {
+			android.atl.AtlGcmProvider.install();
+		} catch (Throwable t) {
+			Slog.w(TAG, "could not install AES/GCM compatibility provider: " + t);
+		}
+	}
+
