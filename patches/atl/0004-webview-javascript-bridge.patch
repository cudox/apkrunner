+typedef struct {
+	WebKitWebView *webview;
+	gchar *name;
+} AtlJavascriptInterface;
+
+static void atl_javascript_interface_free(gpointer data, GClosure *closure)
+{
+	AtlJavascriptInterface *interface = data;
+	g_free(interface->name);
+	g_free(interface);
+}
+
+static void atl_javascript_message_received(WebKitUserContentManager *manager, JSCValue *value, gpointer user_data)
+{
+	AtlJavascriptInterface *interface = user_data;
+	WrapperWidget *wrapper = WRAPPER_WIDGET(gtk_widget_get_parent(GTK_WIDGET(interface->webview)));
+	if (wrapper == NULL || !jsc_value_is_array(value))
+		return;
+
+	JSCValue *length_value = jsc_value_object_get_property(value, "length");
+	guint argc = length_value ? (guint) jsc_value_to_int32(length_value) : 0;
+	if (length_value)
+		g_object_unref(length_value);
+	if (argc < 1)
+		return;
+
+	JNIEnv *env = get_jni_env();
+	if (env == NULL)
+		return;
+	if ((*env)->PushLocalFrame(env, 16) != 0)
+		return;
+
+	JSCValue *method_value = jsc_value_object_get_property_at_index(value, 0);
+	gchar *method = method_value ? jsc_value_to_string(method_value) : NULL;
+	if (method_value)
+		g_object_unref(method_value);
+
+	jclass string_class = (*env)->FindClass(env, "java/lang/String");
+	if (string_class == NULL || method == NULL) {
+		if (method)
+			g_free(method);
+		(*env)->PopLocalFrame(env, NULL);
+		return;
+	}
+
+	jobjectArray arguments = (*env)->NewObjectArray(env, argc - 1, string_class, NULL);
+	for (guint i = 1; i < argc; i++) {
+		JSCValue *argument = jsc_value_object_get_property_at_index(value, i);
+		if (argument == NULL)
+			continue;
+		if (!jsc_value_is_null(argument) && !jsc_value_is_undefined(argument)) {
+			gchar *text = jsc_value_to_string(argument);
+			jstring java_text = (*env)->NewStringUTF(env, text);
+			(*env)->SetObjectArrayElement(env, arguments, i - 1, java_text);
+			(*env)->DeleteLocalRef(env, java_text);
+			g_free(text);
+		}
+		g_object_unref(argument);
+	}
+
+	jclass webview_class = (*env)->GetObjectClass(env, wrapper->jobj);
+	jmethodID dispatch = (*env)->GetMethodID(env, webview_class, "dispatchJavascriptInterface",
+			"(Ljava/lang/String;Ljava/lang/String;[Ljava/lang/String;)V");
+	if (dispatch != NULL) {
+		jstring interface_name = (*env)->NewStringUTF(env, interface->name);
+		jstring method_name = (*env)->NewStringUTF(env, method);
+		(*env)->CallVoidMethod(env, wrapper->jobj, dispatch, interface_name, method_name, arguments);
+		if ((*env)->ExceptionCheck(env)) {
+			(*env)->ExceptionDescribe(env);
+			(*env)->ExceptionClear(env);
+		}
+		(*env)->DeleteLocalRef(env, interface_name);
+		(*env)->DeleteLocalRef(env, method_name);
+	}
+
+	g_free(method);
+	(*env)->PopLocalFrame(env, NULL);
+}
+
+static gchar *atl_javascript_string_literal(const gchar *text)
+{
+	GString *quoted = g_string_new("\"");
+	for (const gchar *p = text; *p; p++) {
+		switch (*p) {
+		case '\\':
+			g_string_append(quoted, "\\\\");
+			break;
+		case '"':
+			g_string_append(quoted, "\\\"");
+			break;
+		case '\n':
+			g_string_append(quoted, "\\n");
+			break;
+		case '\r':
+			g_string_append(quoted, "\\r");
+			break;
+		default:
+			g_string_append_c(quoted, *p);
+		}
+	}
+	g_string_append_c(quoted, '"');
+	return g_string_free(quoted, FALSE);
+}
+
+static void atl_register_javascript_interface(WebKitWebView *webview, const gchar *name)
+{
+	WebKitUserContentManager *manager = webkit_web_view_get_user_content_manager(webview);
+	if (manager == NULL)
+		return;
+
+	gchar *key = g_strdup_printf("atl-javascript-interface-%s", name);
+	if (g_object_get_data(G_OBJECT(webview), key) != NULL) {
+		g_free(key);
+		return;
+	}
+	g_object_set_data(G_OBJECT(webview), key, GINT_TO_POINTER(1));
+	g_free(key);
+
+	AtlJavascriptInterface *interface = g_new0(AtlJavascriptInterface, 1);
+	interface->webview = webview;
+	interface->name = g_strdup(name);
+	gchar *signal = g_strdup_printf("script-message-received::%s", name);
+	g_signal_connect_data(G_OBJECT(manager), signal, G_CALLBACK(atl_javascript_message_received),
+			interface, atl_javascript_interface_free, 0);
+	g_free(signal);
+	webkit_user_content_manager_register_script_message_handler(manager, name, NULL);
+
+	gchar *quoted_name = atl_javascript_string_literal(name);
+	gchar *script = g_strdup_printf(
+			"(function(){"
+			"if(!window.__atl_javascript_interface){"
+			"window.__atl_javascript_interface=function(name){"
+			"var handler=window.webkit&&window.webkit.messageHandlers&&window.webkit.messageHandlers[name];"
+			"if(!handler)return;"
+			"window[name]=new Proxy({},{has:function(target,property){return true;},get:function(target,property){"
+			"if(property==='toString')return function(){return '[object '+name+']';};"
+			"return function(){"
+			"var arguments_array=Array.prototype.slice.call(arguments);"
+			"return handler.postMessage([String(property)].concat(arguments_array));"
+			"};"
+			"}});"
+			"};"
+			"}"
+			"window.__atl_javascript_interface(%s);"
+			"})();", quoted_name);
+	WebKitUserScript *user_script = webkit_user_script_new(script,
+			WEBKIT_USER_CONTENT_INJECT_TOP_FRAME,
+			WEBKIT_USER_SCRIPT_INJECT_AT_DOCUMENT_START,
+			NULL, NULL);
+	webkit_user_content_manager_add_script(manager, user_script);
+	webkit_user_script_unref(user_script);
+	/* The handler may be added after a page has already started. */
+	webkit_web_view_evaluate_javascript(webview, script, -1, NULL, NULL, NULL, NULL, NULL);
+	g_free(script);
+	g_free(quoted_name);
+}
+
+JNIEXPORT void JNICALL Java_android_webkit_WebView_native_1addJavascriptInterface(JNIEnv *env, jobject this, jlong widget_ptr, jstring name)
+{
+	if (!getenv("ATL_UGLY_ENABLE_WEBVIEW") || widget_ptr == 0 || name == NULL)
+		return;
+	const gchar *interface_name = (*env)->GetStringUTFChars(env, name, NULL);
+	if (interface_name != NULL) {
+		atl_register_javascript_interface(_PTR(widget_ptr), interface_name);
+		(*env)->ReleaseStringUTFChars(env, name, interface_name);
+	}
+}
+
+JNIEXPORT void JNICALL Java_android_webkit_WebView_native_1evaluateJavascript(JNIEnv *env, jobject this, jlong widget_ptr, jstring script)
+{
+	if (!getenv("ATL_UGLY_ENABLE_WEBVIEW") || widget_ptr == 0 || script == NULL)
+		return;
+	const gchar *javascript = (*env)->GetStringUTFChars(env, script, NULL);
+	if (javascript != NULL) {
+		webkit_web_view_evaluate_javascript(_PTR(widget_ptr), javascript, -1, NULL, NULL, NULL, NULL, NULL);
+		(*env)->ReleaseStringUTFChars(env, script, javascript);
+	}
+}
